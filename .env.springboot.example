# Variables de entorno de taskflow-api-spring-boot (produccion: /opt/taskflow/.env.springboot)
#
# DATABASE_URL y DIRECT_URL se definen SIN el prefijo jdbc: y SIN userinfo
# (usuario:password en la URL): la aplicacion antepone "jdbc:" y pasa las
# credenciales por propiedades del driver, que es el modo soportado por el
# endpoint PostgreSQL de InsForge.

SPRING_PROFILES_ACTIVE=production
SERVER_PORT=3000
SERVICE_NAME=taskflow-api-springboot
TRAEFIK_HOST=taskflow-api-springboot.xprad.com

DATABASE_URL=postgresql://POOLER_HOST:6543/postgres?sslmode=require
DIRECT_URL=postgresql://DIRECT_HOST:5432/postgres?sslmode=require
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me

CORS_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60