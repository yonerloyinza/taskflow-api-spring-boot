# ==========================================
# PROVEEDOR CLOUD A: INSFORGE POSTGRESQL
# ==========================================
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=3000

# DATABASE_URL usa el pooler de conexiones (puerto 6543); DIRECT_URL se usa para Flyway migraciones
DATABASE_URL="postgresql://USER:PASSWORD@POOLER-HOST.insforge.cloud:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT-HOST.insforge.cloud:5432/postgres?sslmode=require"
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here